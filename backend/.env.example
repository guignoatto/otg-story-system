# Copie este arquivo para backend/.env e preencha os valores reais.

# OpenAI
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Google Drive privado por service account.
# Opcao recomendada para uso local: caminho do JSON baixado no Google Cloud.
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account-otg.json

# Alternativa: JSON inteiro em uma variavel. Use apenas se souber lidar com aspas/escape.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
